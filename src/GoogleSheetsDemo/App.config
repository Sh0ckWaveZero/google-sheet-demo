<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!-- Paste the spreadsheet ID from the sheet URL:
         https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit -->
    <add key="SpreadsheetId" value="1SbOWOfgu2R4cg_PmNtFQA7RxoryUUI_UFsj5fZGIFbs" />
    <!-- Path to the service account key file (see README.md).
         Relative paths are resolved against the app output folder. -->
    <add key="GoogleCredentialsPath" value="credentials.json" />
    <!-- Name of the worksheet tab inside the spreadsheet. -->
    <add key="SheetName" value="ชีต1" />
    <!-- Button theme: auto (follow Windows), light or dark.
         Pressing the sun/moon button in the app writes light/dark here. -->
    <add key="Theme" value="auto" />
  </appSettings>
</configuration>
